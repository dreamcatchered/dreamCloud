# Dream Cloud configuration example. Copy to .env and fill in real values.
# Never commit the real .env file.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram user ID of the dump chat (files are archived here)
DUMP_USER_ID=

# API key required for programmatic uploads (X-Api-Key header).
# Also used to sign CSRF tokens for the web UI. Use a long random string.
API_KEY=

# Base URL of your self-hosted Telegram Bot API server
TG_API_BASE=http://localhost:8081

# Public URL where downloads are served
PUBLIC_URL=https://your-domain.example

# Upload limit in MB (self-hosted Bot API supports up to 2000)
MAX_FILE_SIZE_MB=2000

# SQLite database path
DB_PATH=files.db
